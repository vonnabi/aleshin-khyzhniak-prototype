# Скопіюй у .env (або пропиши у cPanel → Setup Python App → Environment variables)

# Секретний ключ Django. ОБОВʼЯЗКОВО згенеруй свій:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-your-own-generated-key

# На бойовому сервері тримай вимкненим.
DJANGO_DEBUG=false

# Твої домени через кому (без http://). Поки не знаєш — лиши *.
DJANGO_ALLOWED_HOSTS=*

# Адреса сайту без похилої риски в кінці. Домен зміниться — міняється тут.
SITE_URL=https://aleshin-partners.net

# Сповіщення про нові заявки в Telegram (порожньо = вимкнено).
# Токен бота видає @BotFather; chat id — чат, куди бот надсилає повідомлення.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true — додавати в сповіщення текст звернення. За замовчуванням ні: адвокатська таємниця.
TELEGRAM_INCLUDE_MESSAGE=false

# Шлях до бази заявок на хостингу (необовʼязково).
# DJANGO_DB_PATH=/home/user/private/leads.sqlite3

# У день запуску нового сайту: true — він відкривається на головній адресі,
# старий залишається за адресою /aleshin-luxe.html.
SITE_NEW_AT_ROOT=false
